{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js dev server",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": ["./node_modules/next/dist/bin/next", "dev"],
      "port": 3000
    },
    {
      "name": "Static export (out/)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "out"],
      "port": 5174,
      "autoPort": true
    }
  ]
}
